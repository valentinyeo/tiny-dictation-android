<?xml version="1.0" encoding="utf-8"?>
<!-- Floating dictation bar - supports both vertical and horizontal orientations.
     Contains: Mic (toggle recording), Language (EN/DE), Keyboard (switch to keyboard).
     Orientation is controlled programmatically via BubbleService.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- Bar container - orientation set programmatically (vertical or horizontal) -->
    <LinearLayout
        android:id="@+id/floatingBarContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/floating_bar_background"
        android:padding="4dp"
        android:elevation="8dp">

        <!-- Mic button - toggle dictation (main function) -->
        <FrameLayout
            android:id="@+id/bubbleContainer"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="2dp"
            android:background="@drawable/keyboard_button_background"
            android:contentDescription="@string/app_name">

            <ImageView
                android:id="@+id/ivMicrophone"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_mic"
                app:tint="@color/on_surface" />
        </FrameLayout>

        <!-- Language toggle button (EN/DE) -->
        <FrameLayout
            android:id="@+id/languageButtonContainer"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="2dp"
            android:background="@drawable/keyboard_button_background"
            android:contentDescription="Switch language"
            android:visibility="visible">

            <TextView
                android:id="@+id/tvLanguageToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="EN"
                android:textSize="14sp"
                android:textColor="@color/on_surface"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Horizontal bar switch button - switches to horizontal floating bar (companion mode) -->
        <FrameLayout
            android:id="@+id/horizontalBarButtonContainer"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="2dp"
            android:background="@drawable/keyboard_button_background"
            android:contentDescription="Switch to horizontal bar"
            android:visibility="visible">

            <ImageView
                android:id="@+id/ivHorizontalBarButton"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_horizontal_bar"
                app:tint="@color/on_surface" />
        </FrameLayout>

    </LinearLayout>

</FrameLayout>
