<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="4dp">

    <!-- Vertical stack of bubbles (top to bottom: Language, Clipboard, Mic) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Language Toggle Button -->
        <TextView
            android:id="@+id/tvLanguageToggle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bubble_background"
            android:elevation="6dp"
            android:gravity="center"
            android:text="EN"
            android:textColor="@color/bubble_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Paste/Clipboard Button -->
        <TextView
            android:id="@+id/tvPasteButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bubble_background"
            android:elevation="6dp"
            android:gravity="center"
            android:text="📋"
            android:textSize="18sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Main Mic Bubble (at bottom) -->
        <FrameLayout
            android:id="@+id/bubbleContainer"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bubble_background"
            android:elevation="6dp">

            <ImageView
                android:id="@+id/ivMicrophone"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_mic"
                app:tint="@color/bubble_text"
                android:contentDescription="@string/app_name" />

        </FrameLayout>

    </LinearLayout>

</FrameLayout>
