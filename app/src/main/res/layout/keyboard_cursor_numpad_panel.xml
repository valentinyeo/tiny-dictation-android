<?xml version="1.0" encoding="utf-8"?>
<!-- Cursor/Numpad keyboard panel - navigation keys and number pad -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cursorNumpadPanel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@android:color/black"
    android:paddingHorizontal="4dp"
    android:paddingVertical="4dp">

    <!-- LEFT SIDE: Number pad (calculator style) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Row 1: 7 8 9 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView android:id="@+id/numpad_7" style="@style/KeyboardKey" android:text="7" />
            <TextView android:id="@+id/numpad_8" style="@style/KeyboardKey" android:text="8" />
            <TextView android:id="@+id/numpad_9" style="@style/KeyboardKey" android:text="9" />
        </LinearLayout>

        <!-- Row 2: 4 5 6 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView android:id="@+id/numpad_4" style="@style/KeyboardKey" android:text="4" />
            <TextView android:id="@+id/numpad_5" style="@style/KeyboardKey" android:text="5" />
            <TextView android:id="@+id/numpad_6" style="@style/KeyboardKey" android:text="6" />
        </LinearLayout>

        <!-- Row 3: 1 2 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView android:id="@+id/numpad_1" style="@style/KeyboardKey" android:text="1" />
            <TextView android:id="@+id/numpad_2" style="@style/KeyboardKey" android:text="2" />
            <TextView android:id="@+id/numpad_3" style="@style/KeyboardKey" android:text="3" />
        </LinearLayout>

        <!-- Row 4: 0 . = -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView android:id="@+id/numpad_0" style="@style/KeyboardKey" android:text="0" />
            <TextView android:id="@+id/numpad_dot" style="@style/KeyboardKey" android:text="." />
            <TextView android:id="@+id/numpad_equals" style="@style/KeyboardKey" android:text="=" />
        </LinearLayout>

    </LinearLayout>

    <!-- Vertical divider -->
    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginVertical="8dp"
        android:background="@color/surface" />

    <!-- RIGHT SIDE: Cursor/navigation keys -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Row 1: Home, Up, End, PgUp -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView android:id="@+id/cursor_home" style="@style/KeyboardKey" android:text="Home" android:textSize="11sp" />
            <TextView android:id="@+id/cursor_up" style="@style/KeyboardKey" android:text="\u2191" android:textSize="20sp" />
            <TextView android:id="@+id/cursor_end" style="@style/KeyboardKey" android:text="End" android:textSize="11sp" />
            <TextView android:id="@+id/cursor_pgup" style="@style/KeyboardKey" android:text="PgUp" android:textSize="10sp" />
        </LinearLayout>

        <!-- Row 2: Left, (empty), Right, PgDn -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView android:id="@+id/cursor_left" style="@style/KeyboardKey" android:text="\u2190" android:textSize="20sp" />
            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <TextView android:id="@+id/cursor_right" style="@style/KeyboardKey" android:text="\u2192" android:textSize="20sp" />
            <TextView android:id="@+id/cursor_pgdn" style="@style/KeyboardKey" android:text="PgDn" android:textSize="10sp" />
        </LinearLayout>

        <!-- Row 3: Tab, Down, Delete, Backspace -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView android:id="@+id/cursor_tab" style="@style/KeyboardKey" android:text="Tab" android:textSize="11sp" />
            <TextView android:id="@+id/cursor_down" style="@style/KeyboardKey" android:text="\u2193" android:textSize="20sp" />
            <TextView android:id="@+id/cursor_del" style="@style/KeyboardKey" android:text="Del" android:textSize="11sp" />
            <TextView android:id="@+id/cursor_bksp" style="@style/KeyboardKey" android:text="⌫" android:textSize="18sp" />
        </LinearLayout>

        <!-- Row 4: Esc, Space, Enter -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView android:id="@+id/cursor_esc" style="@style/KeyboardKey" android:text="Esc" android:textSize="11sp" />
            <TextView android:id="@+id/cursor_space" style="@style/KeyboardKeySpace" android:text=" " />
            <TextView android:id="@+id/cursor_enter" style="@style/KeyboardKey" android:text="↵" android:textSize="18sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
