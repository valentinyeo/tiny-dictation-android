<?xml version="1.0" encoding="utf-8"?>
<!-- Keyboard companion bar - horizontal bar that sits above the user's keyboard.
     Contains: Mic (toggle recording), Language (EN/DE), Expand (switch to full keyboard).
     Height: 36dp to be less intrusive than the full keyboard bar.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Horizontal bar container - buttons right-aligned for right thumb access -->
    <LinearLayout
        android:id="@+id/companionBarContainer"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/surface_variant"
        android:paddingHorizontal="8dp"
        android:elevation="4dp">

        <!-- Spacer pushes buttons to the right -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Mic button - toggle dictation (main function, rightmost for thumb) -->
        <FrameLayout
            android:id="@+id/btnCompanionMic"
            android:layout_width="36dp"
            android:layout_height="32dp"
            android:background="@drawable/keyboard_button_background"
            android:contentDescription="Toggle dictation">

            <ImageView
                android:id="@+id/ivCompanionMic"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_mic"
                app:tint="@color/on_surface" />
        </FrameLayout>

        <!-- Language toggle button (EN/DE) -->
        <FrameLayout
            android:id="@+id/btnCompanionLanguage"
            android:layout_width="36dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/keyboard_button_background"
            android:contentDescription="Switch language">

            <TextView
                android:id="@+id/tvCompanionLanguage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="EN"
                android:textSize="12sp"
                android:textColor="@color/on_surface"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Floating bar button - switch to floating bubble mode -->
        <FrameLayout
            android:id="@+id/btnCompanionFloatingBar"
            android:layout_width="36dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/keyboard_button_background"
            android:contentDescription="Switch to floating bubble mode">

            <ImageView
                android:id="@+id/ivCompanionFloatingBar"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_floating_bar"
                app:tint="@color/on_surface" />
        </FrameLayout>

        <!-- Expand button - switch to full Tiny Dictation keyboard -->
        <FrameLayout
            android:id="@+id/btnCompanionExpand"
            android:layout_width="36dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/keyboard_button_background"
            android:contentDescription="Switch to Tiny Dictation keyboard">

            <ImageView
                android:id="@+id/ivCompanionExpand"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_keyboard_switch"
                app:tint="@color/on_surface" />
        </FrameLayout>

    </LinearLayout>

</FrameLayout>
