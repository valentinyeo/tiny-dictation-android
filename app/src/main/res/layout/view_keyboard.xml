<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal keyboard layout for Tiny Dictation IME.
     This is intentionally compact since dictation is controlled via the floating bubble.
     The keyboard just needs to:
     1. Show status (dictation active or not)
     2. Provide a button to switch to another keyboard
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="8dp"
    android:background="@color/surface_variant"
    android:minHeight="48dp">

    <!-- Mic icon to indicate this is a dictation keyboard -->
    <ImageView
        android:id="@+id/ivKeyboardMic"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/ic_mic"
        app:tint="@color/primary"
        android:contentDescription="@string/app_name" />

    <!-- Status text showing dictation state -->
    <TextView
        android:id="@+id/tvKeyboardStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/keyboard_status_idle"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:ellipsize="end"
        android:maxLines="1" />

    <!-- Button to switch to another keyboard -->
    <FrameLayout
        android:id="@+id/btnSwitchKeyboard"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/keyboard_switch_hint">

        <ImageView
            android:id="@+id/ivSwitchKeyboard"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_keyboard_switch"
            app:tint="@color/text_secondary" />

    </FrameLayout>

</LinearLayout>
