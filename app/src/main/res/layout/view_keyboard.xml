<?xml version="1.0" encoding="utf-8"?>
<!-- Keyboard layout for Tiny Dictation IME.
     Structure: Expandable panel (emoji/keyboard) + Dictation bar
     IMPORTANT: Keep keyboardContainer ID - applyTheme() depends on it
     Button order: Chevron | Emoji | Keyboard | Clipboard | Enter | MIC | Backspace | Space | Language | SelectAll
     Scroll centers on MIC for thumb access
     SEE CLAUDE.md FOR CANONICAL BUTTON ORDER - DO NOT CHANGE WITHOUT UPDATING IT
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/keyboardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/surface_variant">

    <!-- Expandable emoji panel - lazy loaded via ViewStub for fast keyboard startup -->
    <ViewStub
        android:id="@+id/emojiPanelStub"
        android:layout="@layout/panel_emoji"
        android:layout_width="match_parent"
        android:layout_height="280dp" />

    <!-- Tabbed keyboard panel (QWERTY + Cursor/Numpad) - hidden by default -->
    <include
        layout="@layout/keyboard_tabbed_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <!-- Dictation bar wrapper (FrameLayout for version overlay) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Scrollable dictation bar - scroll centers on MIC button -->
        <HorizontalScrollView
            android:id="@+id/dictationBarScrollView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:fillViewport="true">

            <!-- Main dictation bar - KEEP THIS ID -->
            <LinearLayout
                android:id="@+id/keyboardContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp"
                android:paddingVertical="10dp"
                android:background="@color/surface_variant"
                android:minHeight="64dp">

                <!-- 1. Switch back to previous keyboard (small chevron) -->
                <FrameLayout
                    android:id="@+id/btnSwitchBack"
                    android:layout_width="36dp"
                    android:layout_height="48dp"
                    android:background="@drawable/keyboard_button_background"
                    android:contentDescription="Switch to previous keyboard">

                    <ImageView
                        android:id="@+id/ivSwitchBack"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_chevron_down"
                        app:tint="@color/on_surface" />
                </FrameLayout>

                <!-- 2. Emoji button - toggles emoji panel -->
                <FrameLayout
                    android:id="@+id/btnEmoji"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/keyboard_button_background"
                    android:contentDescription="Emoji picker">

                    <ImageView
                        android:id="@+id/ivEmoji"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_emoji"
                        app:tint="@color/on_surface" />
                </FrameLayout>

                <!-- 3. Keyboard button - toggles tabbed keyboard panel -->
                <FrameLayout
                    android:id="@+id/btnKeyboard"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/keyboard_button_background"
                    android:contentDescription="Keyboard">

                    <ImageView
                        android:id="@+id/ivKeyboard"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_keyboard"
                        app:tint="@color/on_surface" />
                </FrameLayout>

                <!-- 4. Clipboard/History button - opens transcription history -->
                <FrameLayout
                    android:id="@+id/btnHistory"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/keyboard_button_background"
                    android:contentDescription="Transcription history">

                    <ImageView
                        android:id="@+id/ivHistory"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_history"
                        app:tint="@color/on_surface" />
                </FrameLayout>

                <!-- 5. Enter button -->
                <FrameLayout
                    android:id="@+id/btnEnter"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/keyboard_button_background"
                    android:contentDescription="Enter">

                    <ImageView
                        android:id="@+id/ivEnter"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_enter"
                        app:tint="@color/on_surface" />
                </FrameLayout>

                <!-- 6. MIC button - toggle dictation (CENTERED, long press = settings) -->
                <FrameLayout
                    android:id="@+id/btnKeyboardMic"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/keyboard_button_background"
                    android:contentDescription="Toggle dictation">

                    <ImageView
                        android:id="@+id/ivKeyboardMic"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_mic"
                        app:tint="@color/on_surface" />
                </FrameLayout>

                <!-- 7. Backspace button -->
                <FrameLayout
                    android:id="@+id/btnBackspace"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/keyboard_button_background"
                    android:contentDescription="Backspace">

                    <ImageView
                        android:id="@+id/ivBackspace"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_backspace"
                        app:tint="@color/on_surface" />
                </FrameLayout>

                <!-- 8. Space button - insert space -->
                <FrameLayout
                    android:id="@+id/btnSpace"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/keyboard_button_background"
                    android:contentDescription="Space">

                    <ImageView
                        android:id="@+id/ivSpace"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_space_bar"
                        app:tint="@color/on_surface" />
                </FrameLayout>

                <!-- 9. Language switch button -->
                <FrameLayout
                    android:id="@+id/btnLanguage"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/keyboard_button_background"
                    android:contentDescription="Switch language">

                    <TextView
                        android:id="@+id/tvLanguage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="EN"
                        android:textSize="14sp"
                        android:textColor="@color/on_surface"
                        android:textStyle="bold" />
                </FrameLayout>

                <!-- 10. Select All button -->
                <FrameLayout
                    android:id="@+id/btnSelectAll"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/keyboard_button_background"
                    android:contentDescription="Select all">

                    <ImageView
                        android:id="@+id/ivSelectAll"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_select_all"
                        app:tint="@color/on_surface" />
                </FrameLayout>

            </LinearLayout>
        </HorizontalScrollView>

        <!-- Version number - positioned at bottom-right corner -->
        <TextView
            android:id="@+id/tvKeyboardVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:text="v1.11.13"
            android:textSize="7sp"
            android:textColor="#AAFFFFFF"
            android:letterSpacing="0.1"
            android:paddingEnd="4dp"
            android:paddingBottom="2dp" />

    </FrameLayout>

</LinearLayout>
