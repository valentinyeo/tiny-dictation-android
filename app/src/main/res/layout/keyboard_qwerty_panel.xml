<?xml version="1.0" encoding="utf-8"?>
<!-- QWERTY keyboard panel - English only, simple layout -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/qwertyPanel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/black"
    android:paddingHorizontal="4dp"
    android:paddingVertical="4dp">

    <!-- Prediction strip - styled like keyboard keys -->
    <LinearLayout
        android:id="@+id/predictionStrip"
        android:layout_width="match_parent"
        android:layout_height="43dp"
        android:orientation="horizontal"
        android:layout_marginBottom="7dp">

        <TextView
            android:id="@+id/prediction1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:gravity="center"
            android:textSize="16sp"
            android:textColor="@color/keyboard_key_text"
            android:background="@drawable/keyboard_key_background"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/prediction2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:gravity="center"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/keyboard_key_text"
            android:background="@drawable/keyboard_key_background"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/prediction3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:gravity="center"
            android:textSize="16sp"
            android:textColor="@color/keyboard_key_text"
            android:background="@drawable/keyboard_key_background"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- Number row (optional, toggled via settings) - reduced height for Samsung style -->
    <LinearLayout
        android:id="@+id/numberRow"
        android:layout_width="match_parent"
        android:layout_height="43dp"
        android:orientation="horizontal"
        android:layout_marginBottom="7dp"
        android:visibility="gone">

        <TextView android:id="@+id/key_1" style="@style/KeyboardKey" android:text="1" />
        <TextView android:id="@+id/key_2" style="@style/KeyboardKey" android:text="2" />
        <TextView android:id="@+id/key_3" style="@style/KeyboardKey" android:text="3" />
        <TextView android:id="@+id/key_4" style="@style/KeyboardKey" android:text="4" />
        <TextView android:id="@+id/key_5" style="@style/KeyboardKey" android:text="5" />
        <TextView android:id="@+id/key_6" style="@style/KeyboardKey" android:text="6" />
        <TextView android:id="@+id/key_7" style="@style/KeyboardKey" android:text="7" />
        <TextView android:id="@+id/key_8" style="@style/KeyboardKey" android:text="8" />
        <TextView android:id="@+id/key_9" style="@style/KeyboardKey" android:text="9" />
        <TextView android:id="@+id/key_0" style="@style/KeyboardKey" android:text="0" />
    </LinearLayout>

    <!-- Row 1: Q W E R T Y U I O P - with number hints for long-press -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="7dp"
        android:orientation="horizontal">

        <FrameLayout style="@style/KeyboardKeyFrame">
            <TextView android:id="@+id/key_q" style="@style/KeyboardKeyText" android:text="q" />
            <TextView android:id="@+id/hint_q" style="@style/KeyboardKeyHint" android:text="1" android:visibility="gone" />
        </FrameLayout>
        <FrameLayout style="@style/KeyboardKeyFrame">
            <TextView android:id="@+id/key_w" style="@style/KeyboardKeyText" android:text="w" />
            <TextView android:id="@+id/hint_w" style="@style/KeyboardKeyHint" android:text="2" android:visibility="gone" />
        </FrameLayout>
        <FrameLayout style="@style/KeyboardKeyFrame">
            <TextView android:id="@+id/key_e" style="@style/KeyboardKeyText" android:text="e" />
            <TextView android:id="@+id/hint_e" style="@style/KeyboardKeyHint" android:text="3" android:visibility="gone" />
        </FrameLayout>
        <FrameLayout style="@style/KeyboardKeyFrame">
            <TextView android:id="@+id/key_r" style="@style/KeyboardKeyText" android:text="r" />
            <TextView android:id="@+id/hint_r" style="@style/KeyboardKeyHint" android:text="4" android:visibility="gone" />
        </FrameLayout>
        <FrameLayout style="@style/KeyboardKeyFrame">
            <TextView android:id="@+id/key_t" style="@style/KeyboardKeyText" android:text="t" />
            <TextView android:id="@+id/hint_t" style="@style/KeyboardKeyHint" android:text="5" android:visibility="gone" />
        </FrameLayout>
        <FrameLayout style="@style/KeyboardKeyFrame">
            <TextView android:id="@+id/key_y" style="@style/KeyboardKeyText" android:text="y" />
            <TextView android:id="@+id/hint_y" style="@style/KeyboardKeyHint" android:text="6" android:visibility="gone" />
        </FrameLayout>
        <FrameLayout style="@style/KeyboardKeyFrame">
            <TextView android:id="@+id/key_u" style="@style/KeyboardKeyText" android:text="u" />
            <TextView android:id="@+id/hint_u" style="@style/KeyboardKeyHint" android:text="7" android:visibility="gone" />
        </FrameLayout>
        <FrameLayout style="@style/KeyboardKeyFrame">
            <TextView android:id="@+id/key_i" style="@style/KeyboardKeyText" android:text="i" />
            <TextView android:id="@+id/hint_i" style="@style/KeyboardKeyHint" android:text="8" android:visibility="gone" />
        </FrameLayout>
        <FrameLayout style="@style/KeyboardKeyFrame">
            <TextView android:id="@+id/key_o" style="@style/KeyboardKeyText" android:text="o" />
            <TextView android:id="@+id/hint_o" style="@style/KeyboardKeyHint" android:text="9" android:visibility="gone" />
        </FrameLayout>
        <FrameLayout style="@style/KeyboardKeyFrame">
            <TextView android:id="@+id/key_p" style="@style/KeyboardKeyText" android:text="p" />
            <TextView android:id="@+id/hint_p" style="@style/KeyboardKeyHint" android:text="0" android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- Row 2: A S D F G H J K L -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="7dp"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView android:id="@+id/key_a" style="@style/KeyboardKey" android:text="a" />
        <TextView android:id="@+id/key_s" style="@style/KeyboardKey" android:text="s" />
        <TextView android:id="@+id/key_d" style="@style/KeyboardKey" android:text="d" />
        <TextView android:id="@+id/key_f" style="@style/KeyboardKey" android:text="f" />
        <TextView android:id="@+id/key_g" style="@style/KeyboardKey" android:text="g" />
        <TextView android:id="@+id/key_h" style="@style/KeyboardKey" android:text="h" />
        <TextView android:id="@+id/key_j" style="@style/KeyboardKey" android:text="j" />
        <TextView android:id="@+id/key_k" style="@style/KeyboardKey" android:text="k" />
        <TextView android:id="@+id/key_l" style="@style/KeyboardKey" android:text="l" />
    </LinearLayout>

    <!-- Row 3: Shift Z X C V B N M Backspace -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="7dp"
        android:orientation="horizontal">

        <TextView android:id="@+id/key_shift" style="@style/KeyboardKeyWide" android:text="⇧" android:textSize="22sp" />
        <TextView android:id="@+id/key_z" style="@style/KeyboardKey" android:text="z" />
        <TextView android:id="@+id/key_x" style="@style/KeyboardKey" android:text="x" />
        <TextView android:id="@+id/key_c" style="@style/KeyboardKey" android:text="c" />
        <TextView android:id="@+id/key_v" style="@style/KeyboardKey" android:text="v" />
        <TextView android:id="@+id/key_b" style="@style/KeyboardKey" android:text="b" />
        <TextView android:id="@+id/key_n" style="@style/KeyboardKey" android:text="n" />
        <TextView android:id="@+id/key_m" style="@style/KeyboardKey" android:text="m" />
        <ImageView android:id="@+id/key_backspace" style="@style/KeyboardKeyWide"
            android:src="@drawable/ic_keyboard_backspace"
            android:scaleType="center"
            android:contentDescription="Backspace" />
    </LinearLayout>

    <!-- Row 4: !#1 , Space . Enter - shorter row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView android:id="@+id/key_numbers" style="@style/KeyboardKeyWide" android:text="!#1" android:textSize="12sp" />
        <TextView android:id="@+id/key_comma" style="@style/KeyboardKey" android:text="," />
        <TextView android:id="@+id/key_space" style="@style/KeyboardKeySpace" android:text=" " />
        <TextView android:id="@+id/key_period" style="@style/KeyboardKey" android:text="." />
        <ImageView android:id="@+id/key_enter" style="@style/KeyboardKeyWide"
            android:src="@drawable/ic_keyboard_enter"
            android:scaleType="center"
            android:contentDescription="Enter" />
    </LinearLayout>

</LinearLayout>
