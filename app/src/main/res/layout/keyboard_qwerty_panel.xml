<?xml version="1.0" encoding="utf-8"?>
<!-- QWERTY keyboard panel - English only, simple layout -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/qwertyPanel"
    android:layout_width="match_parent"
    android:layout_height="240dp"
    android:orientation="vertical"
    android:background="@android:color/black"
    android:paddingHorizontal="4dp"
    android:paddingVertical="4dp">

    <!-- Prediction strip -->
    <LinearLayout
        android:id="@+id/predictionStrip"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp"
        android:layout_marginBottom="2dp">

        <TextView
            android:id="@+id/prediction1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="14sp"
            android:textColor="@color/keyboard_key_text"
            android:background="@android:color/transparent"
            android:paddingHorizontal="8dp"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:background="@color/keyboard_key_border" />

        <TextView
            android:id="@+id/prediction2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/keyboard_key_text"
            android:background="@android:color/transparent"
            android:paddingHorizontal="8dp"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:background="@color/keyboard_key_border" />

        <TextView
            android:id="@+id/prediction3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="14sp"
            android:textColor="@color/keyboard_key_text"
            android:background="@android:color/transparent"
            android:paddingHorizontal="8dp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- Row 1: Q W E R T Y U I O P -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton android:id="@+id/key_q" style="@style/KeyboardKey" android:text="q" />
        <com.google.android.material.button.MaterialButton android:id="@+id/key_w" style="@style/KeyboardKey" android:text="w" />
        <com.google.android.material.button.MaterialButton android:id="@+id/key_e" style="@style/KeyboardKey" android:text="e" />
        <com.google.android.material.button.MaterialButton android:id="@+id/key_r" style="@style/KeyboardKey" android:text="r" />
        <com.google.android.material.button.MaterialButton android:id="@+id/key_t" style="@style/KeyboardKey" android:text="t" />
        <com.google.android.material.button.MaterialButton android:id="@+id/key_y" style="@style/KeyboardKey" android:text="y" />
        <com.google.android.material.button.MaterialButton android:id="@+id/key_u" style="@style/KeyboardKey" android:text="u" />
        <com.google.android.material.button.MaterialButton android:id="@+id/key_i" style="@style/KeyboardKey" android:text="i" />
        <com.google.android.material.button.MaterialButton android:id="@+id/key_o" style="@style/KeyboardKey" android:text="o" />
        <com.google.android.material.button.MaterialButton android:id="@+id/key_p" style="@style/KeyboardKey" android:text="p" />
    </LinearLayout>

    <!-- Row 2: A S D F G H J K L -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <com.google.android.material.button.MaterialButton android:id="@+id/key_a" style="@style/KeyboardKey" android:text="a" />
        <com.google.android.material.button.MaterialButton android:id="@+id/key_s" style="@style/KeyboardKey" android:text="s" />
        <com.google.android.material.button.MaterialButton android:id="@+id/key_d" style="@style/KeyboardKey" android:text="d" />
        <com.google.android.material.button.MaterialButton android:id="@+id/key_f" style="@style/KeyboardKey" android:text="f" />
        <com.google.android.material.button.MaterialButton android:id="@+id/key_g" style="@style/KeyboardKey" android:text="g" />
        <com.google.android.material.button.MaterialButton android:id="@+id/key_h" style="@style/KeyboardKey" android:text="h" />
        <com.google.android.material.button.MaterialButton android:id="@+id/key_j" style="@style/KeyboardKey" android:text="j" />
        <com.google.android.material.button.MaterialButton android:id="@+id/key_k" style="@style/KeyboardKey" android:text="k" />
        <com.google.android.material.button.MaterialButton android:id="@+id/key_l" style="@style/KeyboardKey" android:text="l" />
    </LinearLayout>

    <!-- Row 3: Shift Z X C V B N M Backspace -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton android:id="@+id/key_shift" style="@style/KeyboardKeyWide" android:text="⇧" android:textSize="20sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/key_z" style="@style/KeyboardKey" android:text="z" />
        <com.google.android.material.button.MaterialButton android:id="@+id/key_x" style="@style/KeyboardKey" android:text="x" />
        <com.google.android.material.button.MaterialButton android:id="@+id/key_c" style="@style/KeyboardKey" android:text="c" />
        <com.google.android.material.button.MaterialButton android:id="@+id/key_v" style="@style/KeyboardKey" android:text="v" />
        <com.google.android.material.button.MaterialButton android:id="@+id/key_b" style="@style/KeyboardKey" android:text="b" />
        <com.google.android.material.button.MaterialButton android:id="@+id/key_n" style="@style/KeyboardKey" android:text="n" />
        <com.google.android.material.button.MaterialButton android:id="@+id/key_m" style="@style/KeyboardKey" android:text="m" />
        <com.google.android.material.button.MaterialButton android:id="@+id/key_backspace" style="@style/KeyboardKeyWide" android:text="⌫" android:textSize="20sp" />
    </LinearLayout>

    <!-- Row 4: 123 , Space . Enter -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton android:id="@+id/key_numbers" style="@style/KeyboardKeyWide" android:text="123" android:textSize="12sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/key_comma" style="@style/KeyboardKey" android:text="," />
        <com.google.android.material.button.MaterialButton android:id="@+id/key_space" style="@style/KeyboardKeySpace" android:text=" " />
        <com.google.android.material.button.MaterialButton android:id="@+id/key_period" style="@style/KeyboardKey" android:text="." />
        <com.google.android.material.button.MaterialButton android:id="@+id/key_enter" style="@style/KeyboardKeyWide" android:text="↵" android:textSize="20sp" />
    </LinearLayout>

</LinearLayout>
