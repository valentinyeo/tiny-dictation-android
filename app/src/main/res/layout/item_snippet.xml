<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardSnippet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardBackgroundColor="@color/keyboard_key_background"
    app:cardElevation="1dp"
    app:cardCornerRadius="12dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp"
        android:minHeight="60dp">

        <!-- Snippet text - smaller font, more lines visible -->
        <TextView
            android:id="@+id/tvSnippetText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="3"
            android:ellipsize="end"
            android:textSize="12sp"
            android:lineSpacingMultiplier="1.1"
            android:textColor="@color/keyboard_key_text"
            tools:text="This is an example snippet that could span multiple lines." />

        <!-- Footer row with snippet icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end|center_vertical"
            android:layout_marginTop="6dp">

            <ImageView
                android:id="@+id/ivSnippetIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:padding="2dp"
                android:src="@drawable/ic_note"
                app:tint="@color/on_surface_variant"
                android:alpha="0.6"
                android:contentDescription="@string/snippet" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
