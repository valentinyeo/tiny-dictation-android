<?xml version="1.0" encoding="utf-8"?>
<!-- Agent commands panel - Quick access to Claude Code commands -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/claudePanel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp">

        <!-- Section: Quick Actions (Most Used) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Quick Actions"
            android:textSize="11sp"
            android:textColor="@color/primary"
            android:textStyle="bold"
            android:paddingTop="4dp"
            android:paddingBottom="2dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView android:id="@+id/claude_quick_init"
                style="@style/ClaudeCommandKey"
                android:layout_weight="1"
                android:text="/init"
                android:tag="/init" />

            <TextView android:id="@+id/claude_quick_clear"
                style="@style/ClaudeCommandKey"
                android:layout_weight="1"
                android:text="/clear"
                android:tag="/clear" />

            <TextView android:id="@+id/claude_quick_exit"
                style="@style/ClaudeCommandKey"
                android:layout_weight="1"
                android:text="/exit"
                android:tag="/exit" />

            <TextView android:id="@+id/claude_quick_esc"
                style="@style/ClaudeCommandKey"
                android:layout_weight="1"
                android:text="Esc"
                android:tag="\u001b" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView android:id="@+id/claude_quick_compact"
                style="@style/ClaudeCommandKey"
                android:layout_weight="1"
                android:text="/compact"
                android:tag="/compact" />

            <TextView android:id="@+id/claude_quick_usage"
                style="@style/ClaudeCommandKey"
                android:layout_weight="1"
                android:text="/usage"
                android:tag="/usage" />

            <TextView android:id="@+id/claude_quick_cost"
                style="@style/ClaudeCommandKey"
                android:layout_weight="1"
                android:text="/cost"
                android:tag="/cost" />

            <TextView android:id="@+id/claude_quick_send"
                style="@style/ClaudeCommandKey"
                android:layout_weight="1"
                android:text="/send"
                android:tag="/send" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView android:id="@+id/claude_quick_resume"
                style="@style/ClaudeCommandKey"
                android:layout_weight="1"
                android:text="/resume"
                android:tag="/resume" />

            <TextView android:id="@+id/claude_quick_mcp"
                style="@style/ClaudeCommandKey"
                android:layout_weight="1"
                android:text="/mcp"
                android:tag="/mcp" />
        </LinearLayout>

        <!-- Section: Agent Modes -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Agent Modes"
            android:textSize="11sp"
            android:textColor="@color/primary"
            android:textStyle="bold"
            android:paddingTop="8dp"
            android:paddingBottom="2dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView android:id="@+id/claude_mode_worker"
                style="@style/ClaudeCommandKey"
                android:layout_weight="1"
                android:text="/worker"
                android:tag="/worker" />

            <TextView android:id="@+id/claude_mode_planner"
                style="@style/ClaudeCommandKey"
                android:layout_weight="1"
                android:text="/planner"
                android:tag="/planner" />

            <TextView android:id="@+id/claude_mode_qa"
                style="@style/ClaudeCommandKey"
                android:layout_weight="1"
                android:text="/qa"
                android:tag="/qa" />

            <TextView android:id="@+id/claude_mode_hyper"
                style="@style/ClaudeCommandKey"
                android:layout_weight="1"
                android:text="/hyper"
                android:tag="/hyper" />

            <TextView android:id="@+id/claude_mode_coordinator"
                style="@style/ClaudeCommandKey"
                android:layout_weight="1"
                android:text="/coordinator"
                android:textSize="9sp"
                android:tag="/coordinator" />
        </LinearLayout>

        <!-- Section: Shell Launch Commands -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Launch"
            android:textSize="11sp"
            android:textColor="@color/primary"
            android:textStyle="bold"
            android:paddingTop="8dp"
            android:paddingBottom="2dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView android:id="@+id/claude_launch_skip"
                style="@style/ClaudeCommandKey"
                android:layout_weight="1"
                android:text="claude -d"
                android:textSize="9sp"
                android:tag="claude --dangerously-skip-permissions" />

            <TextView android:id="@+id/claude_launch_both"
                style="@style/ClaudeCommandKey"
                android:layout_weight="1"
                android:text="claude -d -c"
                android:textSize="9sp"
                android:tag="claude --dangerously-skip-permissions --continue" />
        </LinearLayout>

        <!-- Section: Session Commands -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Session"
            android:textSize="11sp"
            android:textColor="@color/primary"
            android:textStyle="bold"
            android:paddingTop="8dp"
            android:paddingBottom="2dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView android:id="@+id/claude_reset"
                style="@style/ClaudeCommandKey"
                android:layout_weight="1"
                android:text="/reset"
                android:tag="/reset" />

            <TextView android:id="@+id/claude_undo"
                style="@style/ClaudeCommandKey"
                android:layout_weight="1"
                android:text="/undo"
                android:tag="/undo" />

            <TextView android:id="@+id/claude_memory"
                style="@style/ClaudeCommandKey"
                android:layout_weight="1"
                android:text="/memory"
                android:tag="/memory" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView android:id="@+id/claude_model_opus"
                style="@style/ClaudeCommandKey"
                android:layout_weight="1"
                android:text="/model opus"
                android:textSize="9sp"
                android:tag="/model opus" />

            <TextView android:id="@+id/claude_model_sonnet"
                style="@style/ClaudeCommandKey"
                android:layout_weight="1"
                android:text="/model sonnet"
                android:textSize="9sp"
                android:tag="/model sonnet" />

            <TextView android:id="@+id/claude_model_haiku"
                style="@style/ClaudeCommandKey"
                android:layout_weight="1"
                android:text="/model haiku"
                android:textSize="9sp"
                android:tag="/model haiku" />
        </LinearLayout>

        <!-- Section: File Commands -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Files"
            android:textSize="11sp"
            android:textColor="@color/primary"
            android:textStyle="bold"
            android:paddingTop="8dp"
            android:paddingBottom="2dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView android:id="@+id/claude_add"
                style="@style/ClaudeCommandKey"
                android:layout_weight="1"
                android:text="/add"
                android:tag="/add" />

            <TextView android:id="@+id/claude_commit"
                style="@style/ClaudeCommandKey"
                android:layout_weight="1"
                android:text="/commit"
                android:tag="/commit" />

            <TextView android:id="@+id/claude_diff"
                style="@style/ClaudeCommandKey"
                android:layout_weight="1"
                android:text="/diff"
                android:tag="/diff" />
        </LinearLayout>

        <!-- Section: Help/Info -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Help"
            android:textSize="11sp"
            android:textColor="@color/primary"
            android:textStyle="bold"
            android:paddingTop="8dp"
            android:paddingBottom="2dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView android:id="@+id/claude_help"
                style="@style/ClaudeCommandKey"
                android:layout_weight="1"
                android:text="/help"
                android:tag="/help" />

            <TextView android:id="@+id/claude_status"
                style="@style/ClaudeCommandKey"
                android:layout_weight="1"
                android:text="/status"
                android:tag="/status" />

            <TextView android:id="@+id/claude_doctor"
                style="@style/ClaudeCommandKey"
                android:layout_weight="1"
                android:text="/doctor"
                android:tag="/doctor" />
        </LinearLayout>

        <!-- Section: Review Commands -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Review"
            android:textSize="11sp"
            android:textColor="@color/primary"
            android:textStyle="bold"
            android:paddingTop="8dp"
            android:paddingBottom="2dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView android:id="@+id/claude_review"
                style="@style/ClaudeCommandKey"
                android:layout_weight="1"
                android:text="/review"
                android:tag="/review" />

            <TextView android:id="@+id/claude_pr"
                style="@style/ClaudeCommandKey"
                android:layout_weight="1"
                android:text="/pr"
                android:tag="/pr" />

            <TextView android:id="@+id/claude_bug"
                style="@style/ClaudeCommandKey"
                android:layout_weight="1"
                android:text="/bug"
                android:tag="/bug" />
        </LinearLayout>

        <!-- Section: Tools -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tools"
            android:textSize="11sp"
            android:textColor="@color/primary"
            android:textStyle="bold"
            android:paddingTop="8dp"
            android:paddingBottom="2dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView android:id="@+id/claude_terminal"
                style="@style/ClaudeCommandKey"
                android:layout_weight="1"
                android:text="/terminal"
                android:tag="/terminal" />

            <TextView android:id="@+id/claude_vim"
                style="@style/ClaudeCommandKey"
                android:layout_weight="1"
                android:text="/vim"
                android:tag="/vim" />

            <TextView android:id="@+id/claude_login"
                style="@style/ClaudeCommandKey"
                android:layout_weight="1"
                android:text="/login"
                android:tag="/login" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
