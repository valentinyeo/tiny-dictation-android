<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".settings.VoiceCommandsActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="Voice Commands" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Description -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Say these commands while dictating for hands-free control. Commands work even with trailing punctuation."
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Basic punctuation (period, comma, question mark, exclamation mark, colon, new line, new paragraph) is handled automatically by Deepgram dictation mode."
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <!-- Deletion Commands -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardElevation="0dp"
                style="@style/Widget.Material3.CardView.Outlined">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="Deletion"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface" />

                    <include layout="@layout/item_voice_command"
                        android:id="@+id/cmdScratchThat" />
                    <include layout="@layout/item_voice_command"
                        android:id="@+id/cmdUndoThat" />
                    <include layout="@layout/item_voice_command"
                        android:id="@+id/cmdDelete" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Navigation & Editing -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardElevation="0dp"
                style="@style/Widget.Material3.CardView.Outlined">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="Navigation"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface" />

                    <include layout="@layout/item_voice_command"
                        android:id="@+id/cmdTab" />
                    <include layout="@layout/item_voice_command"
                        android:id="@+id/cmdSpace" />
                    <include layout="@layout/item_voice_command"
                        android:id="@+id/cmdSelectAll" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Symbols -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardElevation="0dp"
                style="@style/Widget.Material3.CardView.Outlined">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="Symbols"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface" />

                    <include layout="@layout/item_voice_command"
                        android:id="@+id/cmdSemicolon" />
                    <include layout="@layout/item_voice_command"
                        android:id="@+id/cmdHyphen" />
                    <include layout="@layout/item_voice_command"
                        android:id="@+id/cmdUnderscore" />
                    <include layout="@layout/item_voice_command"
                        android:id="@+id/cmdAtSign" />
                    <include layout="@layout/item_voice_command"
                        android:id="@+id/cmdHashtag" />
                    <include layout="@layout/item_voice_command"
                        android:id="@+id/cmdAmpersand" />
                    <include layout="@layout/item_voice_command"
                        android:id="@+id/cmdAsterisk" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Quotes & Brackets -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardElevation="0dp"
                style="@style/Widget.Material3.CardView.Outlined">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="Quotes &amp; Brackets"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface" />

                    <include layout="@layout/item_voice_command"
                        android:id="@+id/cmdOpenQuote" />
                    <include layout="@layout/item_voice_command"
                        android:id="@+id/cmdCloseQuote" />
                    <include layout="@layout/item_voice_command"
                        android:id="@+id/cmdSingleQuote" />
                    <include layout="@layout/item_voice_command"
                        android:id="@+id/cmdOpenParen" />
                    <include layout="@layout/item_voice_command"
                        android:id="@+id/cmdCloseParen" />
                    <include layout="@layout/item_voice_command"
                        android:id="@+id/cmdOpenBracket" />
                    <include layout="@layout/item_voice_command"
                        android:id="@+id/cmdCloseBracket" />
                    <include layout="@layout/item_voice_command"
                        android:id="@+id/cmdOpenBrace" />
                    <include layout="@layout/item_voice_command"
                        android:id="@+id/cmdCloseBrace" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
