<?xml version="1.0" encoding="utf-8"?>
<!-- Tabbed keyboard panel with QWERTY and Cursor/Numpad tabs -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keyboardTabbedPanel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/surface_variant">

    <!-- Simple tab bar using LinearLayout (Material TabLayout fails in IME context) -->
    <LinearLayout
        android:id="@+id/keyboardTabBar"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:background="@color/surface_variant">

        <TextView
            android:id="@+id/tabABC"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="ABC"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:background="?android:attr/selectableItemBackground" />

        <TextView
            android:id="@+id/tabNumpad"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="123↑"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/on_surface_variant"
            android:background="?android:attr/selectableItemBackground" />

    </LinearLayout>

    <!-- Tab indicator line -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/surface">

        <View
            android:id="@+id/tabIndicator"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="@color/primary" />

    </FrameLayout>

    <!-- Swipeable container for keyboard panels -->
    <FrameLayout
        android:id="@+id/keyboardPagesContainer"
        android:layout_width="match_parent"
        android:layout_height="200dp">

        <!-- Page 0: QWERTY keyboard (uses qwertyPanel ID from included layout) -->
        <include
            layout="@layout/keyboard_qwerty_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Page 1: Cursor/Numpad keyboard (uses cursorNumpadPanel ID from included layout) -->
        <include
            layout="@layout/keyboard_cursor_numpad_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

</LinearLayout>
