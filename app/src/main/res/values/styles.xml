<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base keyboard key style (using TextView to avoid Material3 rounded corners) -->
    <style name="KeyboardKey">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/keyboard_key_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:background">@drawable/keyboard_key_background</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Wide keys (shift, backspace, enter, 123) - accent color -->
    <style name="KeyboardKeyWide" parent="KeyboardKey">
        <item name="android:layout_weight">1.5</item>
        <item name="android:textSize">16sp</item>
        <item name="android:background">@drawable/keyboard_key_accent_background</item>
    </style>

    <!-- Space bar - extra wide -->
    <style name="KeyboardKeySpace" parent="KeyboardKey">
        <item name="android:layout_weight">4</item>
    </style>

    <!-- Frame for keys with number hints (top row) -->
    <style name="KeyboardKeyFrame">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:background">@drawable/keyboard_key_background</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Main letter text inside frame -->
    <style name="KeyboardKeyText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/keyboard_key_text</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Small number hint in top-right corner -->
    <style name="KeyboardKeyHint">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">top|end</item>
        <item name="android:textSize">9sp</item>
        <item name="android:textColor">#80FFFFFF</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingEnd">4dp</item>
    </style>

    <!-- Small long-press hint in top-left corner (for umlauts etc.) -->
    <style name="KeyboardKeyHintLeft">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">top|start</item>
        <item name="android:textSize">9sp</item>
        <item name="android:textColor">#80FFFFFF</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingStart">4dp</item>
    </style>

    <!-- Shell command key (compact for 8 per row) -->
    <style name="ShellKey">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/keyboard_key_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:background">@drawable/shell_key_background</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Shell command key wide (for 4 per row) -->
    <style name="ShellKeyWide" parent="ShellKey">
        <item name="android:textSize">11sp</item>
    </style>

    <!-- Claude command key (for Claude panel) -->
    <style name="ClaudeCommandKey">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">4dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/keyboard_key_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:background">@drawable/keyboard_key_background</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
