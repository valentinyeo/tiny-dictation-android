<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base keyboard key style -->
    <style name="KeyboardKey" parent="android:Widget.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/keyboard_key_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:background">@drawable/keyboard_key_background</item>
    </style>

    <!-- Wide keys (shift, backspace, enter, 123) -->
    <style name="KeyboardKeyWide" parent="KeyboardKey">
        <item name="android:layout_weight">1.5</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Space bar - extra wide -->
    <style name="KeyboardKeySpace" parent="KeyboardKey">
        <item name="android:layout_weight">4</item>
    </style>

    <!-- Shell command key (compact for 8 per row) -->
    <style name="ShellKey" parent="android:Widget.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">1dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/keyboard_key_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:background">@drawable/shell_key_background</item>
    </style>

    <!-- Shell command key wide (for 4 per row) -->
    <style name="ShellKeyWide" parent="ShellKey">
        <item name="android:textSize">11sp</item>
    </style>

    <!-- Claude command key (for Claude panel) -->
    <style name="ClaudeCommandKey" parent="android:Widget.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">4dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/keyboard_key_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:background">@drawable/keyboard_key_background</item>
    </style>
</resources>
