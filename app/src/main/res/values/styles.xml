<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base keyboard key style -->
    <style name="KeyboardKey" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/keyboard_key_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/keyboard_key_background</item>
        <item name="cornerRadius">6dp</item>
    </style>

    <!-- Wide keys (shift, backspace, enter, 123) -->
    <style name="KeyboardKeyWide" parent="KeyboardKey">
        <item name="android:layout_weight">1.5</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Icon-based wide keys (shift, backspace, enter) -->
    <style name="KeyboardKeyIcon" parent="KeyboardKeyWide">
        <item name="iconGravity">textTop</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">20dp</item>
        <item name="iconTint">@color/keyboard_key_text</item>
    </style>

    <!-- Space bar - extra wide -->
    <style name="KeyboardKeySpace" parent="KeyboardKey">
        <item name="android:layout_weight">4</item>
    </style>

    <!-- Keyboard tab text style -->
    <style name="KeyboardTabText" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Shell command key (compact for 8 per row) -->
    <style name="ShellKey" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">1dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/keyboard_key_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/keyboard_key_background</item>
        <item name="cornerRadius">4dp</item>
    </style>

    <!-- Shell command key wide (for 4 per row) -->
    <style name="ShellKeyWide" parent="ShellKey">
        <item name="android:textSize">11sp</item>
    </style>
</resources>
