<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base keyboard key style -->
    <style name="KeyboardKey" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/surface</item>
        <item name="cornerRadius">6dp</item>
    </style>

    <!-- Wide keys (shift, backspace, enter, 123) -->
    <style name="KeyboardKeyWide" parent="KeyboardKey">
        <item name="android:layout_weight">1.5</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Space bar - extra wide -->
    <style name="KeyboardKeySpace" parent="KeyboardKey">
        <item name="android:layout_weight">4</item>
    </style>

    <!-- Keyboard tab text style -->
    <style name="KeyboardTabText" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
