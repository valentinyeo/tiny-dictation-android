<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Custom style for EmojiPickerView to customize category headers -->
    <style name="EmojiPickerStyle">
        <!-- Override text color to white for category headers -->
        <item name="android:textColorPrimary">#CCFFFFFF</item>
        <!-- Category icon color - slightly dimmed white -->
        <item name="colorControlNormal">#AAFFFFFF</item>
    </style>

    <!-- Square button style - override Material3 rounded corners -->
    <style name="SquareButton" parent="Widget.Material3.Button">
        <item name="shapeAppearance">@style/SquareShape</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="SquareShape" parent="">
        <item name="cornerSize">0dp</item>
    </style>

    <style name="Theme.TinyDictation" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Override default button style to be square -->
        <item name="materialButtonStyle">@style/SquareButton</item>

        <!-- Primary colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimary">@color/on_primary</item>

        <!-- Secondary colors -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondary">@color/on_secondary</item>

        <!-- Error colors -->
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/on_error</item>

        <!-- Surface colors -->
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>

        <!-- Background colors -->
        <item name="android:colorBackground">@color/surface</item>
        <item name="colorOnBackground">@color/on_surface</item>

        <!-- Outline -->
        <item name="colorOutline">@color/outline</item>

        <!-- Status and navigation bars -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- Ensure window background uses surface color -->
        <item name="android:windowBackground">@color/surface</item>
    </style>
</resources>
